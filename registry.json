            "font-family": "var(--tx-font-heading)"
          },
          ".tx-pocket-card-description": {
            "color": "var(--tx-muted-foreground)"
          },
          "@media (forced-colors: active)": {
            ":root .tx-pocket-card": {
              "border": "1px solid CanvasText"
            },
            ":root .tx-pocket-card::before, :root .tx-pocket-card::after, :root .tx-pocket-card-rivet": {
              "display": "none"
            },
            ":root .tx-pocket-card-tag": {
              "border": "1px solid CanvasText"
            }
          }
        }
      }
    }
  ]
}
