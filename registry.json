    {
      "name": "field",
      "type": "registry:item",
      "title": "Field look",
      "description": "The cream canvas look shared by Input, Textarea and the Select trigger.",
      "dependencies": [],
      "registryDependencies": [
        "@threadcn/base"
      ],
      "css": {
        "@layer components": {
          ".tx-field": {
            "border": "0",
            "border-radius": "calc(var(--tx-radius) - 4px)",
            "background-color": "var(--tx-field)",
            "color": "var(--tx-field-foreground)",
            "outline": "var(--tx-thread-width) dashed var(--tx-field-border)",
            "outline-offset": "-5px",
            "box-shadow": "inset 0 2px 3px rgb(0 0 0 / 0.14)",
            "transition": "outline-color 120ms,\n      box-shadow 120ms"
          },
          ".tx-field::placeholder": {
            "color": "color-mix(in srgb, var(--tx-field-foreground) 70%, var(--tx-field))"
          },
          ".tx-field:hover:not(:disabled, [data-disabled])": {
            "outline-color": "var(--tx-field-foreground)"
          },
          ".tx-field:is(:focus-visible, [data-popup-open])": {
            "outline": "2px solid var(--tx-field-foreground)",
            "box-shadow": "inset 0 2px 3px rgb(0 0 0 / 0.14),\n      var(--tx-focus-ring)"
          },
          ".tx-field:is([aria-invalid=\"true\"], [data-invalid])": {
            "outline": "2px solid var(--tx-invalid-edge)"
          },
          ".tx-field:is(:disabled, [data-disabled])": {
            "opacity": "0.55",
            "cursor": "not-allowed"
          },
          "@media (prefers-reduced-motion: reduce)": {
            ":root .tx-field": {
              "transition": "none"
            }
          },
          "@media (forced-colors: active)": {
            ":root .tx-field:is(:focus-visible, [aria-invalid=\"true\"], [data-invalid])": {
              "outline-width": "3px"
            }
          }
        }
      }
    },
