          },
          ".tx-badge-destructive": {
            "--_bg": "var(--tx-patch-destructive)",
            "--_fg": "var(--tx-patch-destructive-foreground)"
          },
          ".tx-badge-outline, .tx-badge-ghost, .tx-badge-link": {
            "--_bg": "transparent",
            "--_fg": "var(--tx-surface-foreground)",
            "box-shadow": "none"
          },
          ".tx-badge-outline": {
            "--_stitch": "var(--tx-thread)",
            "--_inset": "1px"
          },
          ".tx-badge-ghost, .tx-badge-link": {
